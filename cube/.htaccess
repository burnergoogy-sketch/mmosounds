# Apache config for GoDaddy cPanel-style hosting
AddType application/wasm .wasm
AddType application/octet-stream .data
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/wasm application/octet-stream
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|data|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
